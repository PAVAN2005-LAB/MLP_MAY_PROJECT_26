own'`) to preserve pattern structures cleanly within gradient boosted tree branches.\n* <span style=\"color:#3498db\">**Blue Zone (<50% Sparsity):**</span> Contains key continuous metrics like `OperationalHoursMeter` (**40.84%** missing). This specific tier is best handled through joint strategic preprocessing: a binary missingness indicator column (`Hours_isna`) combined with a robust median imputation to protect underlying distribution models from tail distortions.","metadata":{}},{"cell_type":"code","source":"# Plot 3.4: Median Price by Equipment Classification\ncat_price=(train.groupby('FunctionalClassification')[TARGET]\n             .agg(['median','count'])\n             .query('count >= 0')\n             .sort_values('median')\n             .tail(15))\n\nfig,ax = plt.subplots(figsize=(12, 5))\nfig.suptitle('Plot 3.4: Median Price by Equipment Classification most 15 ',fontsize=14,fontweight='bold')\nax.barh(cat_price.index,cat_price['median'], color=sns.color_palette('plasma',len(cat_price)))\nax.set_xlabel(\"Median TargetValue ($)\")\nplt.tight_layout()\nplt.show()\n\n# Plot 3.4: Median Price by Equipment Classification\ncat_price=(train.groupby('FunctionalClassification')[TARGET]\n             .agg(['median','count'])\n             .query('count >= 0')\n             .sort_values('median')\n             .head(15))\n\nfig,ax = plt.subplots(figsize=(12, 5))\nfig.suptitle('Plot 3.4: Median Price by Equipment Classification last 15',fontsize=14,fontweight='bold')\nax.barh(cat_price.index,cat_price['median'], color=sns.color_palette('plasma',len(cat_price)))\nax.set_xlabel(\"Median TargetValue ($)\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-22T18:52:53.508735Z","iopub.execute_input":"2026-07-22T18:52:53.509033Z","iopub.status.idle":"2026-07-22T18:52:54.080767Z","shell.execute_reply.started":"2026-07-22T18:52:53.509008Z","shell.execute_reply":"2026-07-22T18:52:54.079881Z"}},"outputs":[{"output_type":"disp