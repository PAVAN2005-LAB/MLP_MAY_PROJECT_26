g Application ---\nif 'UtilizationTier' in X_train.columns:\n    X_train['UtilizationTier'] = X_train['UtilizationTier'].fillna('Unspecified')\n    X_test['UtilizationTier'] = X_test['UtilizationTier'].fillna('Unspecified')\n    \n    ordinal_enc = OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1)\n    X_train[['UtilizationTier']] = ordinal_enc.fit_transform(X_train[['UtilizationTier']])\n    X_test[['UtilizationTier']] = ordinal_enc.transform(X_test[['UtilizationTier']])\n    \n    print(\"\\n[Q11] Ordinal Encoding Application\")\n    print(f\"Unique integer values encoded for UtilizationTier: {X_train['UtilizationTier'].nunique()}\")\n\nprint (\"*\"*80)\n\n# --- Q8: Target Encoding (No coding required to print, but here is the implementation) ---\nif 'Spec_BaseClass' in X_train.columns:\n    target_enc = TargetEncoder()\n    X_train['Spec_BaseClass'] = target_enc.fit_transform(X_train['Spec_BaseClass'], y_train)\n    X_test['Spec_BaseClass'] = target_enc.transform(X_test['Spec_BaseClass'])\n    print(\"\\n[Q8] Target Encoding Applied successfully on high-cardinality categorical feature.\")\n'''","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# MILESTONE 4","metadata":{}},{"cell_type":"code","source":"'''\nimport pandas as pd\nimport numpy as np\nfrom sklearn.model_selection import train_test_split, RandomizedSearchCV\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.ensemble import RandomForestRegressor, AdaBoostRegressor\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.metrics import mean_absolute_error\n\n# Load dataset\ndf = pd.read_csv('/kaggle/input/competitions/heavy-equipment-selling-price-prediction-challenge/train.csv', low_memory=False)\n\np\n\n# ========================================== Q1 — Stratified vs. Non-Stratified Split==========================================\n \ndf['UtilizationTier'] = df['UtilizationTier'].fillna(\"Unknown\")\ndf['PriceBand'] = pd.qcut(df['TargetValue'], q=5, labels=False)\n\nX = df.drop(columns=['TargetValue', 'PriceBand'])\ny = df['TargetValue']\nprice_band = df['PriceBand']\n\n# A) Stratified Split\nX_train_strat, X_valid_strat, y_train_strat, y_valid_strat, pb_train_strat, pb_valid_strat = train_test_split(\n    X, y, price_band, test_size=0.3, random_state=42, stratify=price_band\n)\nprop_strat = pb_valid_strat.value_counts().sort_index().values / len(pb_valid_strat)\n\n# B) Unstratified Split\nX_train_unstrat, X_valid_unstrat, y_train_unstrat, y_valid_unstrat, pb_train_unstrat, pb_valid_unstrat = train_test_split(\n    X, y, price_band, test_size=0.3, random_state=42, stratify=None\n)\nprop_unstrat = pb_valid_unstrat.value_counts().sort_index().values / len(pb_valid_unstrat)\n\n# C) Max abs difference\nmax_abs_diff = np.max(np.abs(prop_strat - prop_unstrat))\nprint(f\"[Q1] Max absolute difference in proportions: {max_abs_diff:.4f}\")\n\n# Reassign strictly to Q2 notation\nX_train, X_valid, y_train, y_valid = X_train_strat, X_valid_strat, y_train_strat, y_valid_strat\n\n\n# ==========================================Q2 — Preprocessing Pipeline==========================================\n\ncat_cols = [\"UtilizationTier\", \"DrivetrainType\", \"CabinType\", \"AssetScaleFactor\"]\nnum_cols = [\"ManufactureYear\", \"OperationalHoursMeter\"]\n\ncat_pipe = Pipeline([\n    ('imputer', SimpleImputer(strategy='most_frequent')),\n    ('ohe', OneHotEncoder(handle_unknown='ignore', sparse_output=True))\n])\n\nnum_pipe = Pipeline([\n    ('imputer', SimpleImputer(strategy='mean')),\n    ('scaler', StandardScaler())\n])\n\npreprocessor = ColumnTransformer(\n    transformers=[\n        ('cat', cat_pipe, cat_cols),\n        ('num', num_pipe, num_cols)\n    ],\n    remainder='drop'\n)\n\nX_train_proc = preprocessor.fit_transform(X_train)\nX_valid_proc = preprocessor.transform(X_valid)\n\n# X_train_proc is a sparse matrix, so we use .sum() directly\ntotal_sum = X_train_proc.sum()\nprint(f\"[Q2] Sum of all values in X_train_proc: {total_sum:.3f}\")\n\n\n# ==========================================Q3 — Hyperparameter Tuning with RandomizedSearchCV\n\nrf = RandomForestRegressor(random_state=42)\nparam_dist = {\n    'n_estimators': [50, 100, 200],\n    'max_depth': [5, 10, 15]\n}\n\nrandom_search = RandomizedSearchCV(\n    estimator=rf, param_distributions=param_dist, \n    n_iter=5, cv=3, random_state=42, n_jobs=-1\n)\n\nrandom_search.fit(X_train_proc, y_train)\nbest_n_estimators = random_search.best_params_['n_estimators']\nprint(f\"[Q3] Best n_estimators found: {best_n_estimators}\")\n\n\n# ==========================================Q4 — AdaBoost Estimator Error Variance==========================================\n \nadaboost = AdaBoostRegressor(n_estimators=50, random_state=42)\nadaboost.fit(X_train_proc, y_train)\nerror_variance = np.var(adaboost.estimator_errors_)\nprint(f\"[Q4] AdaBoost estimator error variance: {error_variance:.4f}\")\n\n\n# ==========================================Q5 — Feature ImportanceQ5 — Feature Importance\n\nrf_fixed = RandomForestRegressor(n_estimators=100, max_depth=10, random_state=42)\nrf_fixed.fit(X_train_proc, y_train)\n\nimportances = rf_fixed.feature_importances_\n# max() ties return the first occurrence by default in np.argmax\nmax_importance_idx = np.argmax(importances)\nprint(f\"[Q5] Index of feature with max importance: {max_importance_idx}\")\n\n\n# ==========================================Q6 — Counting MLP Weights==========================================\n \nN = X_train_proc.shape[1]\n# Weight formula: (Input * H1) + (H1 * H2) + (H2 * H3) + (H3 * Output)\nweights = (N * 128) + (128 * 64) + (64 * 32) + (32 * 1)\nprint(f\"[Q6] Total number of connection weights (excluding biases): {weights}\")\n\n\n# ==========================================Q7 — Training Loss After 5 Iterations==========================================\n\nmlp_q7 = MLPRegressor(\n    hidden_layer_sizes=(128, 64, 32), activation=\"relu\", \n    solver=\"adam\", max_iter=5, batch_size=32, random_state=42\n)\n# For max_iter=5, ConvergenceWarning is expected. \nimport warnings\nfrom sklearn.exceptions import ConvergenceWarning\nwith warnings.catch_warnings():\n    warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n    mlp_q7.fit(X_train_proc, y_train)\n\nprint(f\"[Q7] Training loss after 5 iterations: {mlp_q7.loss_:.4f}\")\n\n\n# ==========================================Q8 — Effect of Regularization (alpha)==========================================\n\nmlp_A = MLPRegressor(hidden_layer_sizes=(100,), max_iter=5, random_state=42, alpha=0.0001)\nmlp_B = MLPRegressor(hidden_layer_sizes=(100,), max_iter=5, random_state=42, alpha=1.0)\n\nwith warnings.catch_warnings():\n    warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n    mlp_A.fit(X_train_proc, y_train)\n    mlp_B.fit(X_train_proc, y_train)\n\npred_A = mlp_A.predict(X_train_proc)\npred_B = mlp_B.predict(X_train_proc)\n\nmae_A = mean_absolute_error(y_train, pred_A)\nmae_B = mean_absolute_error(y_train, pred_B)\nmae_diff = abs(mae_A - mae_B)\n\nprint(f\"[Q8] Absolute difference between MAE of Model A and Model B: {mae_diff:.4f}\")\n\n\n# ==========================================Q9 — Validation Performance==========================================\n \npred_valid_q7 = mlp_q7.predict(X_valid_proc)\nvalid_mae_q7 = mean_absolute_error(y_valid, pred_valid_q7)\n\nprint(f\"[Q9] Validation MAE for Q7 model: {valid_mae_q7:.4f}\")\n\n'''","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}