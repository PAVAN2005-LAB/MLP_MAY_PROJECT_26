GBRegressor(n_estimators=250, colsample_bytree=0.7, tree_method='hist', enable_categorical=True, random_state=42, verbosity=0, n_jobs=-1)\nxgb_search = GridSearchCV(estimator=xgb_estimator, param_grid=xgb_param_grid, scoring='neg_root_mean_squared_error', cv=pds_sub, n_jobs=-1)\nxgb_search.fit(X_search_native_sub, y_search_sub)\nbest_xgb_params = xgb_search.best_params_\nprint(f\"Best XGBoost Parameters: {best_xgb_params}\")\n'''","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"'''  for Fast Automated Hyperparameter Tuning using GridSearchCV ---\nTuning dataset shape: (30000, 52)  on train/test spilt \n\n\nTuning Model 1: LightGBM...\nBest LightGBM Parameters: {'learning_rate': 0.05, 'max_depth': 10, 'num_leaves': 95}\n\nTuning Model 2: XGBoost...\nBest XGBoost Parameters: {'learning_rate': 0.05, 'max_depth': 6, 'subsample': 0.9}\n'''\nbest_lgb_params={'learning_rate': 0.05, 'max_depth': 10, 'num_leaves': 95} \nbest_xgb_params={'learning_rate': 0.05, 'max_depth': 6, 'subsample': 0.9}","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"'''\n# =========================================================================\n# 6.2. HYPERPARAMETER TUNING (LIGHTGBM & XGBOOST ONLY VIA RandomizedSearchCV)\n# =========================================================================\n\nprint(\"--- Automated Hyperparameter Tuning using RandomizedSearchCV ---\")\n\nfrom sklearn.model_selection import PredefinedSplit, RandomizedSearchCV\nimport pandas as pd\nimport numpy as np\n\n# =========================================================================\n# 0. Setup Predefined Split for Chronological Validation (prevents leakage)\n# =========================================================================\n# Combine train and val for the search API\nX_search_native = pd.concat([X_train_native, X_val_native]).copy()\nX_search_proc = np.vstack([X_train_proc, X_val_proc])\ny_search = pd.concat([y_t