rain_test_split\nfrom sklearn.metrics import root_mean_squared_error # Note: in older scikit-learn version, use mean_squared_error(..., squared=False)\n# Toggle this flag depending on where you are running the notebook\n\nprint(\"Running in Kaggle Environment...\")\ntrain_path = '/kaggle/input/competitions/heavy-equipment-selling-price-prediction-challenge/train.csv'\ntest_path = '/kaggle/input/competitions/heavy-equipment-selling-price-prediction-challenge/test.csv'\n\nprint(f\"Loading train data from: {train_path}\")\ntrain_df = pd.read_csv(train_path, low_memory=False)\nprint(f\"Loading test data from: {test_path}\")\ntest_df = pd.read_csv(test_path, low_memory=False)\nprint(f\"\\nTrain Shape: {train_df.shape}\")\nprint(f\"Test Shape: {test_df.shape}\")\n# ==========================================\n# CELL 2: DATA INFO & DESCRIPTION\n# ==========================================\nprint(\"\\n\" + \"=\"*50)\nprint(\"SECTION 1: DATA INFO & DESCRIPTION\")\nprint(\"=\"*50)\n# Check target variable presence\ntarget_col = 'TargetValue'\nassert target_col in train_df.columns, f\"Target column '{target_col}' not found in train!\"\nassert target_col not in test_df.columns, f\"Target column '{target_col}' should NOT be in test!\"\nprint(\"\\n--- Columns and Data Types Overview ---\")\ndtypes_summary = train_df.dtypes.value_counts()\nprint(dtypes_summary)\nprint(\"\\n--- Missing Values Summary (Top 15 columns by missing %) ---\")\nmissing_pct = (train_df.isnull().sum() / len(train_df)) * 100\nprint(missing_pct.sort_values(ascending=False).head(15))\n# ==========================================\n# CELL 3: EXPLORATORY DATA ANALYSIS (EDA)\n# ==========================================\nprint(\"\\n\" + \"=\"*50)\nprint(\"SECTION 2: EXPLORATORY DATA ANALYSIS (EDA)\")\nprint(\"=\"*50)\n# 1. Target Value Distribution\nprint(\"\\n--- 1. Target Value (Sale Price) Distribution ---\")\nprint(train_df[target_col].describe())\nprint(f\"Median Sale Price: ${train_df[target_col].median():,.2f}\")\nprint(f\"Mean Sale Price: ${train_df[target_col].mean():,.2f}\")\n# Target log distribution (since metric is RMSLE)\nlog_target = np.log1p(train_df[target_col])\nprint(f\"Skewness of raw TargetValue: {train_df[target_col].skew():.4f}\")\nprint(f\"Skewness of log1p(TargetValue): {log_target.skew():.4f} (Ideal for Linear/Tree Models)\")\n# 2. Manufacture Year Anomaly\nprint(\"\\n--- 2. Manufacture Year Analysis ---\")\nyears_counts = train_df['ManufactureYear'].value_counts()\nmode_year = train_df['ManufactureYear'].mode()[0]\nmode_count = years_counts.get(mode_year, 0)\nprint(f\"Most frequent Manufacture Year (Mode): {mode_year} (occurs {mode_count} times)\")\nprint(\"Note: 1001 is a common default placeholder value indicating missing/unrecorded year data.\")\n# 3. Operational Hours Meter\nprint(\"\\n--- 3. Operational Hours Meter ---\")\nhours_missing_pct = train_df['OperationalHoursMeter'].isnull().mean() * 100\nprint(f\"Missing values percentage in OperationalHoursMeter: {hours_missing_pct:.4f}%\")\ncorr = train_df[target_col].corr(train_df['OperationalHoursMeter'])\nprint(f\"Pearson Correlation between TargetValue and OperationalHoursMeter: {corr:.6f}\")\nprint(\"Note: The correlation is virtually zero, suggesting raw usage hours alone does not linearly correlate with selling price without context of the machinery type.\")\n# 4. High Cardinality Categorical Features\nprint(\"\\n--- 4. Cardinality of Categorical Features (Unique counts) ---\")\ncat_cols = train_df.select_dtypes(include=['object']).columns\ncardinalities = {col: train_df[col].nunique() for col in cat_cols}\nsorted_card = sorted(cardinalities.items(), key=lambda x: x[1], reverse=True)\nfor col, val in sorted_card[:10]:\n    print(f\"  {col}: {val} unique values\")\n# 5. Geographic Volume & Equipment Types\nprint(\"\\n--- 5. Top Regions by Volume ---\")\nprint(train_df['RegionCode'].value_counts().head(5))\n# Avg target value in highest volume region (Florida)\nif 'Florida' in train_df['RegionCode'].values:\n    florida_avg = train_df[train_df['RegionCode'] == 'Florida'][target_col].mean()\n    print(f\"Average TargetValue in Florida: ${florida_avg:,.2f}\")\nelse:\n    # Try case-insensitive search\n    flor_mask = train_df['RegionCode'].astype(str).str.contains('Florida', case=False, na=False)\n    if flor_mask.any():\n        florida_avg = train_df[flor_mask][target_col].mean()\n        print(f\"Average TargetValue in Florida (regex match): ${florida_avg:,.2f}\")\nprint(\"\\n--- 6. Top Equipment Types (FunctionalClassification) ---\")\nprint(train_df['FunctionalClassification'].value_counts().head(5))\n# ==========================================\n# CELL 4: DATA PREPROCESSING & FEATURE ENGINEERING\n# ==========================================\nprint(\"\\n\" + \"=\"*50)\nprint(\"SECTION 3: PREPROCESSING & FEATURE ENGINEERING\")\nprint(\"=\"*50)\ndef preprocess_data(df_in):\n    df = df_in.copy()\n    \n    # 1. Parse TransactionDate and extract datetime parts\n    print(\"Parsing TransactionDate...\")\n    df['TransactionDate'] = pd.to_datetime(df['TransactionDate'], errors='coerce')\n    df['Trans_Year'] = df['TransactionDate'].dt.year\n    df['Trans_Month'] = df['TransactionDate'].dt.month\n    df['Trans_Day'] = df['TransactionDate'].dt.day\n    df['Trans_DayOfWeek'] = df['TransactionDate'].dt.dayofweek\n    df['Trans_DayOfYear'] = df['TransactionDate'].dt.dayofyear\n    \n    # 2. Handle ManufactureYear anomaly (1001)\n    print(\"Handling ManufactureYear placeholder anomaly...\")\n    df['ManufactureYear_is_placeholder'] = (df['ManufactureYear'] == 1001).astype(int)\n    # Replace 1001 with NaN so tree models treat it as missing, rather than a numeric value from the 11th century\n    df.loc[df['ManufactureYear'] == 1001, 'ManufactureYear'] = np.nan\n    \n    # Calculate machine age at transaction date\n    df['MachineAge'] = df['Trans_Year'] - df['ManufactureYear']\n    \n    # 3. Handle missing indicator for OperationalHoursMeter\n    print(\"Creating indicator for missing OperationalHoursMeter...\")\n    df['OperationalHoursMeter_isna'] = df['OperationalHoursMeter'].isnull().astype(int)\n    \n    # 4. Convert all object columns to pandas category type for LightGBM\n    print(\"Converting text columns to pandas categories...\")\n    for col in df.select_dtypes(include=['object']).columns:\n        df[col] = df[col].astype('category')\n        \n    return df\n# Apply preprocessing\ntrain_proc = preprocess_data(train_df)\ntest_proc = preprocess_data(test_df)\n# ==========================================\n# CELL 5: MODEL TRAINING & TEMPORAL VALIDATION\n# ==========================================\nprint(\"\\n\" + \"=\"*50)\nprint(\"SECTION 4: MODEL TRAINING & TEMPORAL VALIDATION\")\nprint(\"=\"*50)\n# Define feature columns to use\ndrop_cols = ['TransactionID', 'AssetID', 'TransactionDate', 'TargetValue']\nfeatures = [col for col in train_proc.columns if col not in drop_cols]\nprint(f\"Number of features used: {len(features)}\")\nprint(f\"Features: {features}\")\n# Log transformation of target\ny = np.log1p(train_proc[target_col])\nX = train_proc[features]\n# Since transactions are time-ordered, sort by date to perform a proper temporal split (avoiding future data leakage)\n# Sort train_proc to find chronological split point\nsort_idx = train_proc['TransactionDate'].sort_values().index\nX_sorted = X.iloc[sort_idx]\ny_sorted = y.iloc[sort_idx]\n# Split 80% train, 20% validation temporally\nsplit_idx = int(len(X_sorted) * 0.8)\nX_train, X_val = X_sorted.iloc[:split_idx], X_sorted.iloc[split_idx:]\ny_train, y_val = y_sorted.iloc[:split_idx], y_sorted.iloc[split_idx:]\nprint(f\"\\nTemporal Split:\")\nprint(f\"  Train samples: {X_train.shape[0]} (Dates: {train_proc['TransactionDate'].iloc[sort_idx].iloc[0].strftime('%Y-%m-%d')} to {train_proc['TransactionDate'].iloc[sort_idx].iloc[split_idx-1].strftime('%Y-%m-%d')})\")\nprint(f\"  Val samples:   {X_val.shape[0]} (Dates: {train_proc['TransactionDate'].iloc[sort_idx].iloc[split_idx].strftime('%Y-%m-%d')} to {train_proc['TransactionDate'].iloc[sort_idx].iloc[-1].strftime('%Y-%m-%d')})\")\n# Set up LightGBM Regressor\nprint(\"\\nTraining LightGBM Regressor...\")\nmodel = lgb.LGBMRegressor(\n    objective='regression',\n    metric='rmse', # RMSE on log target is mathematically equivalent to RMSLE on raw target\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=63,\n    random_state=42,\n    verbose=-1,\n    n_jobs=-1\n)\n# Train the model with early stopping\n# LightGBM handles categorical variables natively if they are dtype 'category'\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=50, verbose=True), lgb.log_evaluation(100)]\n)\n# Predict on validation set and evaluate RMSLE\nval_preds_log = model.predict(X_val)\n# Clip negative predictions if any (prices must be positive)\nval_preds_log = np.clip(val_preds_log, 0, None)\n# In log space, RMSE = RMSLE\n# We can compute RMSLE by using scikit-learn's root_mean_squared_error on log values\nval_rmsle = root_mean_squared_error(y_val, val_preds_log)\nprint(f\"\\n>>> Validation RMSLE Score: {val_rmsle:.5f} <<<\")\n# ==========================================\n# CELL 6: SUBMISSION GENERATION\n# ==========================================\nprint(\"\\n\" + \"=\"*50)\nprint(\"SECTION 5: GENERATING KAGGLE SUBMISSION\")\nprint(\"=\"*50)\n# Re-train on the entire training dataset for maximum performance on test\nprint(\"Re-training model on the full training dataset...\")\nfull_model = lgb.LGBMRegressor(\n    objective='regression',\n    metric='rmse',\n    n_estimators=model.best_iteration_ if model.best_iteration_ else 800,\n    learning_rate=0.05,\n    num_leaves=63,\n    random_state=42,\n    verbose=-1,\n    n_jobs=-1\n)\nfull_model.fit(X, y)\n# Predict on test set\nprint(\"Generating predictions on the test set...\")\ntest_preds_log = full_model.predict(test_proc[features])\n# Inverse log transform: exp(y) - 1\ntest_preds_raw = np.expm1(test_preds_log)\n# Clip negative values if any\ntest_preds_raw = np.clip(test_preds_raw, 0, None)\n# Create submission dataframe\nsubmission = pd.DataFrame({\n    'TransactionID': test_df['TransactionID'],\n    'TargetValue': test_preds_raw\n})\n# Save to CSV\nsub_path = 'submission.csv'\nsubmission.to_csv(sub_path, index=False)\nprint(f\"Submission successfully saved to {sub_path}!\")\nprint(submission.head())\nprint(f\"Total rows in submission: {len(submission)}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-21T02:52:08.046084Z","iopub.execute_input":"2026-06-21T02:52:08.046432Z","iopub.status.idle":"2026-06-21T02:52:35.017883Z","shell.execute_reply.started":"2026-06-21T02:52:08.046405Z","shell.execute_reply":"2026-06-21T02:52:35.016546Z"}},"outputs":[{"name":"stdout","text":"Running in Kaggle Environment...\nLoading train data from: /kaggle/input/competitions/heavy-equipment-selling-price-prediction-challenge/train.csv\nLoading test data from: /kaggle/input/competitions/heavy-equipment-selling-price-prediction-challenge/test.csv\n\nTrain Shape: (138701, 50)\nTest Shape: (15000, 49)\n\n==================================================\nSECTION 1: DATA INFO & DESCRIPTION\n==================================================\n\n--- Columns and Data Types Overview ---\nobject     44\nint64       4\nfloat64     2\nName: count, dtype: int64\n\n--- Missing Values Summary (Top 15 columns by missing %) ---\ncol19    99.952416\ncol18    99.952416\ncol5     92.515555\ncol4     92.515555\ncol27    89.214930\ncol28    89.214930\ncol29    86.393753\ncol30    86.393753\ncol13    83.125572\ncol14    83.125572\ncol7     83.125572\ncol6     83.125572\ncol9     83.125572\ncol8     83.125572\ncol11    83.125572\ndtype: float64\n\n==================================================\nSECTION 2: EXPLORATORY DATA ANALYSIS (EDA)\n==================================================\n\n--- 1. Target Value (Sale Price) Distribution -